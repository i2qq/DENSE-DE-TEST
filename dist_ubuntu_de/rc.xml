<?xml version="1.0"?>
<labwc_config>
  <theme>
    <name>Openbox</name>
    <cornerRadius>12</cornerRadius>
    <dropShadows>yes</dropShadows>
  </theme>
  <desktops>
    <number>4</number>
  </desktops>
  <snapping>
    <range>10</range>
  </snapping>
  <keyboard>
    <default/>
    <keybind key="Super+Return">
      <action name="Execute" command="alacritty"/>
    </keybind>
    <keybind key="Super+space">
      <action name="Execute" command="fuzzel"/>
    </keybind>
    <keybind key="Super+d">
      <action name="Execute" command="fuzzel"/>
    </keybind>
    <keybind key="Super+Escape">
      <action name="Execute" command="dense-taskmanager"/>
    </keybind>
    <keybind key="Ctrl+Shift+Escape">
      <action name="Execute" command="dense-taskmanager"/>
    </keybind>
    <keybind key="Super+e">
      <action name="Execute" command="thunar"/>
    </keybind>
    <keybind key="Super+w">
      <action name="Execute" command="firefox"/>
    </keybind>
    <keybind key="Super+q">
      <action name="Execute" command="toplevel_close"/>
    </keybind>
    <keybind key="Super+f">
      <action name="Execute" command="toplevel_fullscreen"/>
    </keybind>
    <keybind key="Super+1">
      <action name="Execute" command="workspace_switch|1"/>
    </keybind>
    <keybind key="Super+2">
      <action name="Execute" command="workspace_switch|2"/>
    </keybind>
    <keybind key="Super+3">
      <action name="Execute" command="workspace_switch|3"/>
    </keybind>
    <keybind key="Super+4">
      <action name="Execute" command="workspace_switch|4"/>
    </keybind>
    <keybind key="Super+l">
      <action name="Execute" command="session_lock"/>
    </keybind>
    <keybind key="Super+Shift+q">
      <action name="Execute" command="session_logout"/>
    </keybind>
    <keybind key="XF86AudioRaiseVolume">
      <action name="Execute" command="pamixer -i 5"/>
    </keybind>
    <keybind key="XF86AudioLowerVolume">
      <action name="Execute" command="pamixer -d 5"/>
    </keybind>
    <keybind key="XF86AudioMute">
      <action name="Execute" command="pamixer -t"/>
    </keybind>
    <keybind key="XF86MonBrightnessUp">
      <action name="Execute" command="brightnessctl set +5%"/>
    </keybind>
    <keybind key="XF86MonBrightnessDown">
      <action name="Execute" command="brightnessctl set 5%-"/>
    </keybind>
  </keyboard>
  <mouse>
    <gesture type="swipe3_up"><action name="Execute" command="workspace_switch|next"/></gesture>
    <gesture type="swipe3_down"><action name="Execute" command="workspace_switch|prev"/></gesture>
    <gesture type="pinch_in"><action name="Execute" command="overview_toggle"/></gesture>
  </mouse>
  <windowRules>
    <windowRule identifier="alacritty" serverDecoration="yes"/>
    <windowRule identifier="firefox" serverDecoration="yes"/>
    <windowRule identifier="thunar" serverDecoration="yes"/>
    <windowRule identifier="dense-taskmanager" serverDecoration="yes"/>
    <windowRule identifier="fuzzel" serverDecoration="yes"/>
  </windowRules>
</labwc_config>
